{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "cliente": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
    },
    "fecha": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "servicio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "qué se vende en este anuncio"
    },
    "objetivo": {
      "type": "object",
      "properties": {
        "campana": {
          "type": "string",
          "enum": [
            "reconocimiento",
            "trafico",
            "mensajes",
            "clientes_potenciales",
            "ventas"
          ]
        },
        "accion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "qué tiene que hacer quien ve el anuncio"
        },
        "destino": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "WhatsApp, URL o formulario"
        }
      },
      "required": [
        "campana",
        "accion",
        "destino"
      ],
      "additionalProperties": false
    },
    "publico": {
      "type": "object",
      "properties": {
        "quien": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dolor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "zona": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "quien",
        "dolor",
        "zona"
      ],
      "additionalProperties": false
    },
    "estilo": {
      "type": "string",
      "enum": [
        "animacion",
        "avatar",
        "mixto"
      ]
    },
    "avatar": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "origen": {
              "type": "string",
              "enum": [
                "generado",
                "persona_real_con_permiso"
              ]
            },
            "descripcion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "voz": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "acento": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "origen",
            "descripcion",
            "voz",
            "acento"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "plataformas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "instagram_reels",
          "instagram_feed",
          "instagram_stories",
          "facebook_feed",
          "facebook_reels",
          "facebook_stories",
          "tiktok"
        ]
      }
    },
    "formatos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "9x16",
          "4x5"
        ]
      }
    },
    "duracion_max": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "musica": {
      "type": "string",
      "enum": [
        "sin_musica",
        "biblioteca_meta",
        "archivo_propio",
        "generada"
      ]
    },
    "tipo": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "loop-6s",
            "explicativo",
            "avatar-ugc",
            "avatar-pantalla",
            "voz-en-off-broll",
            "dualcast"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "se completa en el paso 3"
    },
    "notas": {
      "type": [
        "string",
        "null"
      ]
    },
    "rutina": {
      "description": "solo en los trabajos que abre la rutina diaria (npm run rutina -- <c> hoy)",
      "type": "object",
      "properties": {
        "pieza": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
        },
        "fecha": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "tema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "pieza",
        "fecha",
        "tema"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "cliente",
    "id",
    "fecha",
    "servicio",
    "objetivo",
    "publico",
    "estilo",
    "avatar",
    "plataformas",
    "formatos",
    "duracion_max",
    "musica",
    "tipo",
    "notas"
  ],
  "additionalProperties": false,
  "$id": "fabrica-creativos/esquemas/brief.schema.json",
  "title": "brief"
}
