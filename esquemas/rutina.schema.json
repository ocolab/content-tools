{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "cliente": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
    },
    "activa": {
      "type": "boolean",
      "description": "false hasta que el cliente la apruebe; npm run rutina hoy no abre nada si está en false"
    },
    "aprobada": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "por": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "fecha": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "por",
            "fecha"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "quién aprobó la rutina y cuándo"
    },
    "dias": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lun",
          "mar",
          "mie",
          "jue",
          "vie",
          "sab",
          "dom"
        ]
      },
      "description": "qué días se produce"
    },
    "hora_aviso": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "hora local a la que se arma el borrador del día y se avisa (recordatorio o tarea programada); null = sin aviso"
    },
    "piezas": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,60}$",
            "description": "nombre corto de la pieza, por ejemplo «avatar» o «loop»"
          },
          "base": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,60}$",
            "description": "id de un trabajo terminado de la empresa (trabajos/<c>/<base>) que se copia cada día"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "loop-6s",
              "explicativo",
              "avatar-ugc",
              "avatar-pantalla",
              "voz-en-off-broll",
              "dualcast"
            ]
          },
          "formatos": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "9x16",
                "4x5"
              ]
            }
          },
          "plataformas": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "instagram_reels",
                "instagram_feed",
                "instagram_stories",
                "facebook_feed",
                "facebook_reels",
                "facebook_stories",
                "tiktok"
              ]
            }
          },
          "reutiliza": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(activos|capturas)\\/[^/]+$"
            },
            "description": "archivos de la base que se usan tal cual todos los días (la presentadora, capturas); lo demás se genera de nuevo"
          }
        },
        "required": [
          "id",
          "base",
          "tipo",
          "formatos",
          "plataformas",
          "reutiliza"
        ],
        "additionalProperties": false
      }
    },
    "temas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "description": "pilares o temas que rotan día a día; los define la empresa"
    },
    "presupuesto_diario_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "description": "tope de gasto por día (créditos de voz, clips, imágenes); no reemplaza el OK de cada gasto. null = sin tope"
    },
    "aprobacion_copy": {
      "type": "string",
      "enum": [
        "cada_dia",
        "semanal"
      ],
      "description": "cuándo aprueba el cliente el copy: el del día, o el de toda la semana de una vez"
    },
    "publicacion": {
      "type": "string",
      "enum": [
        "entregar_mp4",
        "subir_en_pausa"
      ],
      "description": "nunca se publica sola: se entregan los MP4, o se suben a la cuenta del cliente en pausa con su OK"
    },
    "notas": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "version",
    "cliente",
    "activa",
    "aprobada",
    "dias",
    "hora_aviso",
    "piezas",
    "temas",
    "presupuesto_diario_usd",
    "aprobacion_copy",
    "publicacion",
    "notas"
  ],
  "additionalProperties": false,
  "$id": "fabrica-creativos/esquemas/rutina.schema.json",
  "title": "rutina"
}
